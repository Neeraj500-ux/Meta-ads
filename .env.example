# Copy to .env and fill in. Anything left blank is hidden or falls back safely.
VITE_BRAND_NAME=Your Brand Name
VITE_CONTACT_EMAIL=
# Country code + number, digits only. Example: 919876543210
VITE_WHATSAPP=
# Optional: Formspree / Web3Forms / Make / Zapier / your own backend (accepts JSON POST)
VITE_FORM_ENDPOINT=
VITE_PRIVACY_URL=
VITE_TERMS_URL=
# Optional booking link (Calendly, Cal.com...) used by "Book a Strategy Call"
VITE_BOOKING_URL=
